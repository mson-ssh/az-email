# Sao chép thành .env rồi điền mật khẩu (KHÔNG đưa .env lên git)
EMAIL_KEY_USER=admin
EMAIL_KEY_PASS=doi-mat-khau-dai-o-day

# Tích hợp vào CRM https://azcrm.store (AZ Email là 1 tính năng trong CRM)
BASE_PATH=/email
# AUTH=basic             # basic | off (off: chỉ khi CRM đã bắt đăng nhập và app chỉ nghe mạng nội bộ)

# Tuỳ chọn
# PORT=8889
# OCR_ENGINE=auto          # auto | paddle (server) | vision (macOS) | tesseract
# OCR_GPU=0               # 1 = PaddleOCR dùng GPU NVIDIA (build Dockerfile.gpu)
# OCR_LANG=vie+eng        # chỉ dùng cho tesseract
# AUTH_BYPASS_LOCAL=0      # 1 = mở từ 127.0.0.1 trên chính máy chạy thì không hỏi mật khẩu (chỉ dùng trên máy cá nhân)
